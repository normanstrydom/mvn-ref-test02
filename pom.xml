  <modelVersion>4.0.0</modelVersion>
  <groupId>com.devtest</groupId>
  <artifactId>mvn-ref-test02</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
